+    input_reader.read_parameters(PARAM, config.input);
+    const bool input_requests_vl
+        = !PARAM.inp.out_mat_h_vl.empty() && PARAM.inp.out_mat_h_vl.front() != 0;
+    const bool include_vl = config.with_vl || input_requests_vl;
+    const char* active_contract = include_vl ? kVlContract : kContract;
+
+    if (PARAM.inp.basis_type != "lcao")
+    {
+        throw std::runtime_error("H0Lite requires basis_type=lcao in the SCF INPUT");
+    }
+    if (PARAM.inp.gamma_only)
+    {
+        throw std::runtime_error("H0Lite graph export requires gamma_only=0 in the SCF INPUT");
+    }
+    if (PARAM.inp.nspin != 1 || PARAM.inp.noncolin || PARAM.inp.lspinorb)
+    {
+        throw std::runtime_error("H0Lite currently requires scalar nspin=1 without SOC/noncollinear spin");
+    }
+    if (PARAM.inp.esolver_type != "ksdft")
+    {
+        throw std::runtime_error("H0Lite currently requires esolver_type=ksdft");
+    }
+    if (!PARAM.inp.t_in_h || !PARAM.inp.vnl_in_h)
+    {
+        throw std::runtime_error("the SCF INPUT must enable t_in_h=1 and vnl_in_h=1 for the strict H0 contract");
+    }
+    if (PARAM.inp.ntype <= 0 || PARAM.inp.lcao_ecut <= 0.0 || PARAM.inp.lcao_dk <= 0.0
+        || PARAM.inp.lcao_dr <= 0.0 || PARAM.inp.lcao_rmax <= 0.0 || PARAM.inp.pseudo_rcut <= 0.0
+        || PARAM.inp.out_hsr.size() < 2 || PARAM.inp.out_hsr[1] <= 0)
+    {
+        throw std::runtime_error("invalid SCF INPUT parameter required by H0Lite");
+    }
+    input_reader.write_parameters(PARAM, resolved_input_path);
+
+    GlobalV::ofs_running << "ABACUS H0Lite\n"
+                         << "ABACUS source commit: " << H0LITE_ABACUS_COMMIT << "\n"
