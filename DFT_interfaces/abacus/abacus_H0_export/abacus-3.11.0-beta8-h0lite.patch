+                         << "STRU: " << PARAM.globalv.global_in_stru << "\n"
+                         << "pseudo_dir: " << PARAM.inp.pseudo_dir << "\n"
+                         << "orbital_dir: " << PARAM.inp.orbital_dir << "\n"
+                         << std::setprecision(17)
+                         << "lcao_ecut: " << PARAM.inp.lcao_ecut << "\n"
+                         << "lcao_dk: " << PARAM.inp.lcao_dk << "\n"
+                         << "lcao_dr: " << PARAM.inp.lcao_dr << "\n"
+                         << "lcao_rmax: " << PARAM.inp.lcao_rmax << "\n"
+                         << "pseudo_rcut: " << PARAM.inp.pseudo_rcut << "\n"
+                         << "csr_precision_from_input: " << PARAM.inp.out_hsr.at(1) << "\n"
+                         << "vl_included_in_h0: " << include_vl << "\n"
+                         << "vl_requested_by_input: " << input_requests_vl << "\n"
+                         << "h0_operator: " << (include_vl ? "T+Vnl+Vl" : "T+Vnl") << "\n"
