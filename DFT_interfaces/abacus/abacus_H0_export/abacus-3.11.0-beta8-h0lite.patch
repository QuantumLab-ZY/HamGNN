+                       PARAM.globalv.npol,
+                       PARAM.inp.basis_type,
+                       PARAM.inp.esolver_type,
+                       PARAM.inp.init_wfc,
+                       PARAM.inp.nbands);
+
+    LCAO_Orbitals orbitals;
+    TwoCenterBundle two_center;
+    two_center.build_orb(ucell.ntype, ucell.orbital_fn.data(), PARAM.inp.orbital_dir);
+    two_center.to_LCAO_Orbitals(orbitals,
