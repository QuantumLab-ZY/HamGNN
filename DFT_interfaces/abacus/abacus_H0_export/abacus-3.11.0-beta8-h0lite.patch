+                                 PARAM.inp.nspin);
+    ucell.infoNL.reset(nonlocal_info);
+    two_center.build_beta(ucell.ntype, nonlocal_info->get_nonlocal().Beta);
+    // The archived scalar 3.5.3 exporter retained only diagonal projector D.
+    for (int it = 0; it < ucell.ntype; ++it)
+    {
+        auto& pseudo = ucell.atoms[it].ncpp;
+        if (!pseudo.has_so)
+        {
+            ModuleBase::ComplexMatrix diagonal_d(2 * pseudo.nh, 2 * pseudo.nh);
+            for (int ip = 0; ip < pseudo.nh; ++ip)
+            {
+                diagonal_d(ip, ip) = pseudo.d_real(ip, ip);
+                diagonal_d(ip + pseudo.nh, ip + pseudo.nh) = pseudo.d_real(ip, ip);
+            }
+            pseudo.set_d_so(diagonal_d, pseudo.nbeta, pseudo.nh, false, false, 1);
+        }
+    }
+    two_center.tabulate_h0_compat(PARAM.inp.lcao_ecut, PARAM.inp.lcao_dk,
+                                  PARAM.inp.lcao_dr, PARAM.inp.lcao_rmax);
+    GlobalV::ofs_running << "numerical_backend: abacus-v311-simpson-compatible\n"
+                         << "nonlocal_projector_coupling: v353-scalar-diagonal\n";
+    const long long setup_ms = milliseconds(total_start);
+
+    Parallel_Orbitals pv;
+    pv.set_serial(nlocal, nlocal);
+    pv.nrow_bands = nlocal;
+    pv.ncol_bands = PARAM.inp.nbands;
+    pv.set_atomic_trace(ucell.get_iat2iwt(), ucell.nat, nlocal);
+
+    const double search_radius = atom_arrange::set_sr_NL(GlobalV::ofs_running,
+                                                          PARAM.inp.out_level,
+                                                          orbitals.get_rcutmax_Phi(),
+                                                          ucell.infoNL->get_rcutmax_Beta(),
+                                                          PARAM.globalv.gamma_only_local);
+    Grid_Driver grid;
+    atom_arrange::search(PARAM.globalv.search_pbc,
+                         GlobalV::ofs_running,
+                         grid,
+                         ucell,
+                         search_radius,
+                         PARAM.inp.test_atom_input);
+
+    const std::vector<ModuleBase::Vector3<double>> unused_kvec(
+        1, ModuleBase::Vector3<double>(0.0, 0.0, 0.0));
+    hamilt::HContainer<double> s0(&pv);
+    hamilt::HContainer<double> kinetic_matrix(&pv);
+    hamilt::HContainer<double> nonlocal_matrix(&pv);
+
+    const auto matrix_start = std::chrono::steady_clock::now();
+    hamilt::Overlap<hamilt::OperatorLCAO<std::complex<double>, double>> overlap(
+        nullptr,
+        unused_kvec,
+        nullptr,
+        &s0,
+        &ucell,
+        orbitals.cutoffs(),
+        &grid,
+        two_center.overlap_orb.get());
+    overlap.contributeHR();
+
+    hamilt::EKinetic<hamilt::OperatorLCAO<std::complex<double>, double>> kinetic(
+        nullptr,
+        unused_kvec,
+        &kinetic_matrix,
+        &ucell,
+        orbitals.cutoffs(),
+        &grid,
+        two_center.kinetic_orb.get());
+    kinetic.contributeHR();
+
+    hamilt::Nonlocal<hamilt::OperatorLCAO<std::complex<double>, double>> nonlocal(
+        nullptr,
+        unused_kvec,
+        &nonlocal_matrix,
+        &ucell,
+        orbitals.cutoffs(),
+        &grid,
+        two_center.overlap_orb_beta.get());
+    nonlocal.contributeHR();
+    kinetic_matrix.add_value_union(nonlocal_matrix, 1.0);
+    const long long matrix_ms = milliseconds(matrix_start);
+
+    long long vl_ms = 0;
+    if (include_vl)
+    {
+        const auto vl_start = std::chrono::steady_clock::now();
+        if (PARAM.globalv.double_grid)
+        {
+            throw std::runtime_error("H0Lite local-pseudopotential term currently requires the single LCAO density grid");
+        }
+
+        std::string fft_precision = "double";
+        if (PARAM.inp.precision == "single" || PARAM.inp.precision == "mixing")
+        {
+            fft_precision = "mixing";
+        }
+        std::unique_ptr<ModulePW::PW_Basis_Big> pw_rho(
+            new ModulePW::PW_Basis_Big("cpu", fft_precision));
+        pw_rho->setbxyz(PARAM.inp.bx, PARAM.inp.by, PARAM.inp.bz);
+        if (PARAM.inp.nx * PARAM.inp.ny * PARAM.inp.nz == 0)
+        {
+            pw_rho->initgrids(PARAM.inp.ref_cell_factor * ucell.lat0,
+                              ucell.latvec,
+                              4.0 * PARAM.inp.ecutwfc);
+        }
+        else
+        {
+            pw_rho->initgrids(PARAM.inp.ref_cell_factor * ucell.lat0,
+                              ucell.latvec,
+                              PARAM.inp.nx,
+                              PARAM.inp.ny,
+                              PARAM.inp.nz);
+        }
+        pw_rho->initparameters(false, 4.0 * PARAM.inp.ecutwfc);
+        pw_rho->fft_bundle.initfftmode(PARAM.inp.fft_mode);
+        static_cast<ModulePW::PW_Basis*>(pw_rho.get())->setuptransform();
+        pw_rho->collect_local_pw();
+        pw_rho->collect_uniqgg();
+
+        Parallel_Grid parallel_grid;
+        parallel_grid.init(pw_rho->nx,
+                           pw_rho->ny,
+                           pw_rho->nz,
+                           pw_rho->nplane,
+                           pw_rho->nrxx,
+                           pw_rho->nbz,
+                           pw_rho->bz);
+        Structure_Factor structure_factor;
+        structure_factor.set(pw_rho.get(), PARAM.inp.nbspline);
+        structure_factor.setup(&ucell, parallel_grid, pw_rho.get());
+
+        pseudopot_cell_vl local_pseudopotential;
+        local_pseudopotential.init_vloc(ucell, pw_rho.get());
+        std::vector<double> local_potential_grid(pw_rho->nrxx, 0.0);
+        double vl_of_zero = 0.0;
+        elecstate::PotLocal pot_local(&local_pseudopotential.vloc,
+                                      &structure_factor.strucFac,
+                                      pw_rho.get(),
+                                      vl_of_zero);
+        pot_local.cal_fixed_v(local_potential_grid.data());
+
+        std::unique_ptr<ModuleGint::GintInfo> gint_info(new ModuleGint::GintInfo(
+            pw_rho->nbx,
+            pw_rho->nby,
+            pw_rho->nbz,
+            pw_rho->nx,
+            pw_rho->ny,
+            pw_rho->nz,
+            0,
+            0,
+            pw_rho->nbzp_start,
+            pw_rho->nbx,
+            pw_rho->nby,
+            pw_rho->nbzp,
+            orbitals.Phi,
+            ucell,
+            grid));
+        ModuleGint::Gint::set_gint_info(gint_info.get());
+        hamilt::HContainer<double> vl_matrix(&pv, nullptr, &gint_info->get_ijr_info());
+        ModuleGint::Gint_vl vl_integrator(local_potential_grid.data(), &vl_matrix);
+        vl_integrator.cal_gint();
+        ModuleGint::Gint::set_gint_info(nullptr);
+        kinetic_matrix.add_value_union(vl_matrix, 1.0);
+        vl_ms = milliseconds(vl_start);
+        GlobalV::ofs_running << "vl_fft_grid: " << pw_rho->nx << " " << pw_rho->ny << " " << pw_rho->nz << "\n"
+                             << "vl_of_g0: " << std::setprecision(17) << vl_of_zero << "\n"
+                             << "vl_r_blocks_merged: " << vl_matrix.size_R_loop() << "\n";
+    }
+
+    const auto h0_write_start = std::chrono::steady_clock::now();
+    write_matrix(config.output_dir + "h0rs1_nao.csr", "H", ucell, kinetic_matrix, PARAM.inp.out_hsr.at(1));
+    const long long h0_write_ms = milliseconds(h0_write_start);
+    const auto s0_write_start = std::chrono::steady_clock::now();
+    write_matrix(config.output_dir + "s0r_nao.csr", "S", ucell, s0, PARAM.inp.out_hsr.at(1));
+    const long long s0_write_ms = milliseconds(s0_write_start);
+    const long long total_ms = milliseconds(total_start);
+
+    GlobalV::ofs_running << active_contract << "\n"
+                         << "basis_dimension: " << nlocal << "\n"
+                         << "h0_r_blocks: " << kinetic_matrix.size_R_loop() << "\n"
+                         << "s0_r_blocks: " << s0.size_R_loop() << "\n"
+                         << "setup_ms: " << setup_ms << "\n"
+                         << "matrix_ms: " << matrix_ms << "\n"
+                         << "vl_ms: " << vl_ms << "\n"
+                         << "h0_write_ms: " << h0_write_ms << "\n"
+                         << "s0_write_ms: " << s0_write_ms << "\n"
+                         << "total_ms: " << total_ms << "\n"
+                         << "Finish Time\n";
+    GlobalV::ofs_running.close();
+    GlobalV::ofs_warning.close();
+
+    std::cout << active_contract << "\n"
+              << "basis_dimension=" << nlocal << " setup_ms=" << setup_ms << " matrix_ms=" << matrix_ms
+              << " total_ms=" << total_ms << std::endl;
+    return 0;
+}
+
+} // namespace
