+
+std::string directory(std::string value)
+{
+    if (value.empty())
+    {
+        throw std::runtime_error("directory argument must not be empty");
+    }
+    if (value.back() != '/')
+    {
+        value.push_back('/');
+    }
+    return value;
+}
+
+void require_directory(const std::string& value)
+{
+    struct stat info
+    {
+    };
+    if (stat(value.c_str(), &info) != 0 || !S_ISDIR(info.st_mode))
+    {
+        throw std::runtime_error("directory does not exist: " + value);
+    }
+}
+
+bool path_exists(const std::string& value)
+{
+    struct stat info
+    {
+    };
+    return stat(value.c_str(), &info) == 0;
+}
+
+std::string element_key(const std::string& value)
+{
+    std::string key;
+    for (const char ch : value)
+    {
+        if (!std::isalpha(static_cast<unsigned char>(ch)))
+        {
+            break;
+        }
+        key.push_back(static_cast<char>(std::tolower(static_cast<unsigned char>(ch))));
+    }
+    return key;
+}
+
+void read_pseudopotentials(UnitCell& ucell, std::ofstream& log)
+{
+    for (int it = 0; it < ucell.ntype; ++it)
+    {
+        Atom& atom = ucell.atoms[it];
+        Pseudopot_upf reader;
+        reader.coulomb_potential = atom.coulomb_potential;
+        const std::string path = PARAM.inp.pseudo_dir + ucell.pseudo_fn[it];
+        const int error = reader.init_pseudo_reader(path, ucell.pseudo_type[it], atom.ncpp);
+        if (error != 0)
+        {
+            throw std::runtime_error("failed to read pseudopotential (error " + std::to_string(error) + "): " + path);
+        }
+        if (atom.flag_empty_element)
+        {
+            reader.set_empty_element(atom.ncpp);
+        }
+        reader.set_upf_q(atom.ncpp);
+        if (reader.average_p(PARAM.inp.soc_lambda, atom.ncpp, PARAM.inp.lspinorb) != 0)
+        {
+            throw std::runtime_error("failed to scalar-average pseudopotential: " + path);
+        }
+        reader.complete_default(atom.ncpp, PARAM.inp.pseudo_rcut);
+        atom.coulomb_potential = reader.coulomb_potential;
+        if (atom.ncpp.pp_type != "NC")
+        {
+            throw std::runtime_error("h0lite LCAO route requires an NC pseudopotential: " + path);
+        }
+        if (!atom.label_orb.empty() && element_key(atom.label_orb) != element_key(atom.ncpp.psd))
+        {
+            throw std::runtime_error("orbital/pseudopotential element mismatch for " + atom.label);
+        }
+        log << "Pseudopotential " << atom.label << ": " << path << " (" << atom.ncpp.nbeta
+            << " projectors)\n";
+    }
+}
+
+void write_matrix(const std::string& final_path,
+                  const std::string& label,
+                  const UnitCell& ucell,
+                  hamilt::HContainer<double>& matrix,
+                  const int precision)
+{
+    const std::string temporary = final_path + ".tmp." + std::to_string(static_cast<long long>(getpid()));
+    std::ofstream output(temporary);
+    if (!output)
+    {
+        throw std::runtime_error("cannot open output: " + temporary);
+    }
+    output << " --- Ionic Step 1 ---\n";
+    output << " # print " << label << " matrix in real space " << label << "(R)\n";
+    output << " 1 # number of spin directions\n";
+    output << " 1 # spin index\n";
+    output << " " << matrix.get_nbasis() << " # number of localized basis\n";
+    output << " " << matrix.size_R_loop() << " # number of Bravais lattice vector R\n\n";
+    ModuleIO::UcellIO::write_ucell(output, &ucell);
+    output << "\n";
+    constexpr double sparse_threshold = 1.0e-10;
+    hamilt::Output_HContainer<double> writer(&matrix, output, sparse_threshold, precision);
+    writer.write();
+    output.close();
+    if (!output)
+    {
+        std::remove(temporary.c_str());
+        throw std::runtime_error("failed while writing output: " + temporary);
+    }
+    if (std::rename(temporary.c_str(), final_path.c_str()) != 0)
+    {
+        const int error = errno;
+        std::remove(temporary.c_str());
+        throw std::runtime_error("cannot install output " + final_path + ": errno " + std::to_string(error));
+    }
+}
+
+long long milliseconds(const std::chrono::steady_clock::time_point& start)
+{
+    return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start).count();
+}
+
+int run(const Config& config)
+{
+    const auto total_start = std::chrono::steady_clock::now();
+    const std::string log_path = config.output_dir + "running_h0lite.log";
+    const std::string warning_path = config.output_dir + "warning_h0lite.log";
+    const std::string resolved_input_path = config.output_dir + "INPUT.resolved";
+    const std::vector<std::string> protected_outputs = {
+        config.output_dir + "h0rs1_nao.csr",
+        config.output_dir + "s0r_nao.csr",
+        resolved_input_path,
+        log_path,
+        warning_path};
+    for (const std::string& path : protected_outputs)
+    {
+        if (path_exists(path))
+        {
+            throw std::runtime_error("refusing to overwrite existing output: " + path);
+        }
+    }
+    GlobalV::ofs_running.open(log_path);
+    GlobalV::ofs_warning.open(warning_path);
+    if (!GlobalV::ofs_running || !GlobalV::ofs_warning)
+    {
+        throw std::runtime_error("cannot open h0lite logs in " + config.output_dir);
+    }
+
+    GlobalV::MY_RANK = 0;
+    GlobalV::NPROC = 1;
+    PARAM.set_pal_param(0, 1, 1);
+    ModuleIO::ReadInput input_reader(0);
