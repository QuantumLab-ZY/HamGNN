+        << "CASE defaults to the current directory. A single case automatically uses\n"
+        << "SLURM_CPUS_PER_TASK, or all CPUs available to the process outside Slurm.\n\n"
+        << "Options:\n"
+        << "  --case-list FILE       one case directory per line\n"
+        << "  --tasks N              concurrent cases in this process (default: 1)\n"
+        << "  --cpus-per-task N      OpenMP CPUs per case (batch default: available/tasks)\n"
+        << "  --with-vl              merge the local pseudopotential Vl into H0\n"
+        << "  --shard-index I        explicit zero-based shard index\n"
+        << "  --shard-count N        explicit shard count\n"
+        << "  --version              print source version\n"
+        << "  --license              print embedded redistribution notices\n";
+}
