+Cli parse_cli(const int argc, char** argv)
+{
+    Cli cli;
+    for (int i = 1; i < argc; ++i)
+    {
+        const std::string arg = argv[i];
+        auto next = [&](const std::string& option) -> std::string {
+            if (++i >= argc)
+            {
+                throw std::runtime_error("missing value after " + option);
+            }
+            return argv[i];
+        };
+        if (arg == "--help" || arg == "-h")
+        {
+            cli.show_help = true;
+        }
+        else if (arg == "--version")
+        {
+            cli.show_version = true;
+        }
+        else if (arg == "--license")
+        {
+            cli.show_license = true;
+        }
+        else if (arg == "--with-vl")
+        {
+            cli.with_vl = true;
+        }
+        else if (arg == "--case-list")
+        {
+            cli.case_list = next(arg);
+        }
+        else if (arg == "--tasks" || arg == "--jobs")
+        {
+            cli.tasks = parse_positive(arg, next(arg));
+        }
+        else if (arg == "--cpus-per-task" || arg == "--threads" || arg == "--threads-per-case")
+        {
+            cli.cpus_per_task = parse_positive(arg, next(arg));
+        }
+        else if (arg == "--shard-index")
+        {
+            cli.shard_index = parse_nonnegative(arg, next(arg));
+        }
+        else if (arg == "--shard-count")
+        {
+            cli.shard_count = parse_positive(arg, next(arg));
+        }
+        else if (arg == "--input")
+        {
+            cli.raw_input = next(arg);
+        }
+        else if (arg == "--output-dir")
+        {
+            cli.raw_output_dir = next(arg);
+        }
+        else if (!arg.empty() && arg.front() == '-')
+        {
+            throw std::runtime_error("unknown option: " + arg);
+        }
+        else
+        {
+            cli.positional_cases.push_back(arg);
+        }
+    }
+    return cli;
+}
+
+std::string json_escape(const std::string& value)
+{
+    std::ostringstream output;
+    for (const unsigned char ch : value)
+    {
+        switch (ch)
+        {
+            case '\\': output << "\\\\"; break;
+            case '"': output << "\\\""; break;
+            case '\b': output << "\\b"; break;
+            case '\f': output << "\\f"; break;
+            case '\n': output << "\\n"; break;
+            case '\r': output << "\\r"; break;
+            case '\t': output << "\\t"; break;
+            default:
+                if (ch < 0x20)
+                {
+                    output << "\\u" << std::hex << std::setw(4) << std::setfill('0')
+                           << static_cast<int>(ch) << std::dec;
+                }
+                else
+                {
+                    output << ch;
+                }
+        }
+    }
+    return output.str();
+}
+
+std::string quote(const std::string& value)
+{
+    return "\"" + json_escape(value) + "\"";
+}
+
+std::string utc_now()
+{
+    const std::time_t now = std::time(nullptr);
+    std::tm utc {};
+    gmtime_r(&now, &utc);
+    char buffer[32];
+    std::strftime(buffer, sizeof(buffer), "%Y-%m-%dT%H:%M:%SZ", &utc);
+    return buffer;
+}
+
+std::string unique_tag()
+{
+    char hostname[256] = {};
+    if (gethostname(hostname, sizeof(hostname) - 1) != 0)
+    {
+        std::strcpy(hostname, "host");
+    }
+    std::string host(hostname);
+    for (char& ch : host)
+    {
+        if (!std::isalnum(static_cast<unsigned char>(ch)) && ch != '-' && ch != '_')
+        {
+            ch = '_';
+        }
+    }
+    const auto stamp = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                           std::chrono::system_clock::now().time_since_epoch())
+                           .count();
+    return std::to_string(stamp) + "-" + host + "-" + std::to_string(static_cast<long long>(getpid()));
+}
+
+FileRecord file_record(const fs::path& path)
+{
+    struct stat info {};
+    if (lstat(path.c_str(), &info) != 0 || !S_ISREG(info.st_mode) || S_ISLNK(info.st_mode) || info.st_size <= 0)
+    {
+        throw std::runtime_error("missing, empty, or non-regular file: " + path.string());
+    }
+    FileRecord record;
+    record.path = fs::absolute(path).lexically_normal().string();
+    record.size = static_cast<long long>(info.st_size);
+#if defined(__APPLE__)
+    record.mtime_ns = static_cast<long long>(info.st_mtimespec.tv_sec) * 1000000000LL
+                      + info.st_mtimespec.tv_nsec;
+#else
+    record.mtime_ns = static_cast<long long>(info.st_mtim.tv_sec) * 1000000000LL + info.st_mtim.tv_nsec;
+#endif
+    return record;
+}
+
+bool exists_or_symlink(const fs::path& path)
+{
+    std::error_code error;
+    const fs::file_status status = fs::symlink_status(path, error);
+    return !error && status.type() != fs::file_type::not_found;
+}
+
+std::string read_text(const fs::path& path)
+{
+    std::ifstream input(path);
+    if (!input)
+    {
+        throw std::runtime_error("cannot read file: " + path.string());
+    }
+    std::ostringstream text;
+    text << input.rdbuf();
+    if (!input.good() && !input.eof())
+    {
+        throw std::runtime_error("failed while reading file: " + path.string());
+    }
+    return text.str();
+}
+
+void write_text_atomic(const fs::path& path, const std::string& text)
+{
+    const fs::path temporary = path.parent_path()
+                               / ("." + path.filename().string() + ".tmp-"
+                                  + std::to_string(static_cast<long long>(getpid())));
+    if (exists_or_symlink(temporary))
+    {
+        throw std::runtime_error("temporary output already exists: " + temporary.string());
+    }
+    {
+        std::ofstream output(temporary);
+        if (!output)
+        {
+            throw std::runtime_error("cannot create temporary output: " + temporary.string());
+        }
+        output << text;
+        output.close();
+        if (!output)
+        {
+            throw std::runtime_error("failed while writing temporary output: " + temporary.string());
+        }
+    }
+    if (std::rename(temporary.c_str(), path.c_str()) != 0)
+    {
+        const int error = errno;
+        std::remove(temporary.c_str());
+        throw std::runtime_error("cannot install output " + path.string() + ": " + std::strerror(error));
+    }
+}
+
+InputData parse_input(const fs::path& path)
+{
+    file_record(path);
+    std::ifstream input(path);
+    InputData data;
+    std::ostringstream effective;
+    std::string line;
+    while (std::getline(input, line))
+    {
+        const std::string clean = uncomment(line);
+        const std::vector<std::string> words = split_words(clean);
+        if (!words.empty() && lower(words.front()) != "input_parameters")
+        {
+            const std::string key = lower(words.front());
+            if (key == "out_interval")
+            {
+                data.removed_keys.push_back(key);
+                continue;
+            }
+            data.values[key] = std::vector<std::string>(words.begin() + 1, words.end());
+        }
+        effective << line << "\n";
+    }
+    if (!input.eof())
+    {
+        throw std::runtime_error("failed while reading INPUT: " + path.string());
+    }
+    std::sort(data.removed_keys.begin(), data.removed_keys.end());
+    data.removed_keys.erase(std::unique(data.removed_keys.begin(), data.removed_keys.end()), data.removed_keys.end());
+    data.effective_text = effective.str();
+    return data;
+}
+
+std::string input_value(const InputData& input, const std::string& key, const std::string& fallback)
+{
+    const auto found = input.values.find(key);
+    if (found == input.values.end() || found->second.empty())
+    {
+        return fallback;
+    }
+    if (found->second.size() != 1)
+    {
+        throw std::runtime_error("INPUT key requires one value: " + key);
+    }
+    return found->second.front();
+}
+
+bool parse_bool(const std::string& name, const std::string& value)
+{
+    const std::string normalized = lower(value);
+    if (normalized == "1" || normalized == "true" || normalized == "t")
+    {
+        return true;
+    }
+    if (normalized == "0" || normalized == "false" || normalized == "f")
+    {
+        return false;
+    }
+    throw std::runtime_error("invalid boolean value for " + name + ": " + value);
+}
+
+fs::path resolve_from(const fs::path& base, const std::string& value)
+{
+    fs::path path(value);
+    if (path.is_relative())
+    {
+        path = base / path;
+    }
+    return fs::absolute(path).lexically_normal();
+}
+
+fs::path directory_parameter(const fs::path& case_dir, const InputData& input, const std::string& key)
+{
+    const fs::path path = resolve_from(case_dir, input_value(input, key, "."));
+    std::error_code error;
+    if (!fs::is_directory(path, error) || error)
+    {
+        throw std::runtime_error("missing " + key + ": " + path.string());
+    }
+    return path;
+}
+
+std::vector<std::string> section(const std::vector<std::string>& lines, const std::string& name)
+{
+    static const std::set<std::string> names = {
+        "ATOMIC_SPECIES", "NUMERICAL_ORBITAL", "NUMERICAL_DESCRIPTOR", "ABFS_ORBITAL",
+        "ABFS_JLES_ORBITAL", "LATTICE_CONSTANT", "LATTICE_VECTORS", "LATTICE_PARAMETERS",
+        "ATOMIC_POSITIONS", "PAW_FILES"};
+    const auto found = std::find(lines.begin(), lines.end(), name);
+    if (found == lines.end())
+    {
+        throw std::runtime_error("STRU is missing section " + name);
+    }
+    std::vector<std::string> result;
+    for (auto current = found + 1; current != lines.end() && names.count(*current) == 0; ++current)
+    {
+        result.push_back(*current);
+    }
+    return result;
+}
+
+std::vector<Dependency> resolve_dependencies(const fs::path& case_dir,
+                                             const fs::path& stru,
+                                             const InputData& input)
+{
+    std::ifstream source(stru);
+    if (!source)
+    {
+        throw std::runtime_error("cannot read STRU: " + stru.string());
+    }
+    std::vector<std::string> lines;
+    std::string line;
+    while (std::getline(source, line))
+    {
+        const std::string clean = uncomment(line);
+        if (!clean.empty())
+        {
+            lines.push_back(clean);
+        }
+    }
+    const std::vector<std::string> species = section(lines, "ATOMIC_SPECIES");
+    const std::vector<std::string> orbitals = section(lines, "NUMERICAL_ORBITAL");
+    if (species.empty())
+    {
+        throw std::runtime_error("STRU has no ATOMIC_SPECIES entries");
+    }
+    if (species.size() != orbitals.size())
+    {
+        throw std::runtime_error("LCAO STRU requires one NUMERICAL_ORBITAL file per species");
+    }
+    const fs::path pseudo_dir = directory_parameter(case_dir, input, "pseudo_dir");
+    const fs::path orbital_dir = directory_parameter(case_dir, input, "orbital_dir");
+    std::vector<Dependency> result;
+    for (const std::string& entry : species)
+    {
+        const std::vector<std::string> fields = split_words(entry);
+        if (fields.size() < 3)
+        {
+            throw std::runtime_error("invalid ATOMIC_SPECIES entry: " + entry);
+        }
+        const fs::path declared = pseudo_dir / fields[2];
+        std::error_code error;
+        const fs::path resolved = fs::canonical(declared, error);
+        if (error)
+        {
+            throw std::runtime_error("cannot resolve pseudopotential " + declared.string() + ": " + error.message());
+        }
+        result.push_back({"pseudopotential", fields[2], declared.string(), file_record(resolved)});
+    }
+    for (const std::string& entry : orbitals)
+    {
+        const std::vector<std::string> fields = split_words(entry);
+        if (fields.size() != 1)
+        {
+            throw std::runtime_error("invalid NUMERICAL_ORBITAL entry: " + entry);
+        }
+        const fs::path declared = orbital_dir / fields[0];
+        std::error_code error;
+        const fs::path resolved = fs::canonical(declared, error);
+        if (error)
+        {
+            throw std::runtime_error("cannot resolve orbital " + declared.string() + ": " + error.message());
+        }
+        result.push_back({"orbital", fields[0], declared.string(), file_record(resolved)});
+    }
+    return result;
+}
+
+void validate_source_input(const InputData& input)
+{
+    if (lower(input_value(input, "basis_type", "pw")) != "lcao")
+    {
+        throw std::runtime_error("H0Lite requires basis_type=lcao");
+    }
+    if (parse_bool("gamma_only", input_value(input, "gamma_only", "0")))
+    {
+        throw std::runtime_error("H0Lite graph export requires gamma_only=0");
+    }
+    if (input_value(input, "nspin", "1") != "1")
+    {
+        throw std::runtime_error("H0Lite currently requires scalar nspin=1");
+    }
+    if (parse_bool("lspinorb", input_value(input, "lspinorb", "0")))
+    {
+        throw std::runtime_error("H0Lite does not support spin-orbit coupling");
+    }
+    if (!parse_bool("t_in_h", input_value(input, "t_in_h", "1"))
+        || !parse_bool("vnl_in_h", input_value(input, "vnl_in_h", "1")))
+    {
+        throw std::runtime_error("strict H0 requires t_in_h=1 and vnl_in_h=1");
+    }
+}
+
+std::string file_record_json(const FileRecord& file, const int indent)
+{
+    const std::string pad(static_cast<std::size_t>(indent), ' ');
+    std::ostringstream output;
+    output << "{\n"
+           << pad << "  \"path\": " << quote(file.path) << ",\n"
+           << pad << "  \"size\": " << file.size << ",\n"
+           << pad << "  \"mtime_ns\": " << file.mtime_ns << "\n"
+           << pad << "}";
+    return output.str();
+}
+
+std::string array_json(const std::vector<std::string>& values)
+{
+    std::ostringstream output;
+    output << "[";
+    for (std::size_t i = 0; i < values.size(); ++i)
+    {
+        if (i != 0)
+        {
+            output << ", ";
+        }
+        output << quote(values[i]);
+    }
+    output << "]";
+    return output.str();
+}
+
+bool reusable_marker(const fs::path& marker, const bool with_vl)
+{
+    if (!exists_or_symlink(marker))
+    {
+        return false;
+    }
+    file_record(marker);
+    const std::string text = read_text(marker);
+    const bool expected_mode = text.find(std::string("\"enabled\": ") + (with_vl ? "true" : "false"))
+                               != std::string::npos;
+    if (text.find("\"status\": \"complete\"") == std::string::npos
+        || text.find(std::string("\"generator\": \"") + kGenerator + "\"") == std::string::npos
+        || !expected_mode)
+    {
+        throw std::runtime_error("existing H0 marker is incompatible: " + marker.string());
+    }
+    file_record(marker.parent_path() / "h0rs1_nao.csr");
+    file_record(marker.parent_path() / "s0r_nao.csr");
+    return true;
+}
+
+void validate_backend(const fs::path& log, const bool with_vl)
+{
+    const std::string text = read_text(log);
+    const char* expected = with_vl ? kBackendVlContract : kBackendContract;
+    const char* unexpected = with_vl ? kBackendContract : kBackendVlContract;
+    if (text.find("Finish Time") == std::string::npos || text.find(expected) == std::string::npos
+        || text.find(unexpected) != std::string::npos)
+    {
+        throw std::runtime_error("H0Lite backend contract validation failed: " + log.string());
+    }
+}
+
+std::string marker_json(const fs::path& case_dir,
+                        const fs::path& input_path,
+                        const fs::path& stru,
+                        const InputData& input,
+                        const std::vector<Dependency>& dependencies,
+                        const fs::path& archive,
+                        const FileRecord& h0,
+                        const FileRecord& s0,
+                        const bool with_vl,
+                        const bool vl_from_input,
+                        const bool vl_from_cli,
+                        const int cpus,
+                        const int tasks,
+                        const Shard& shard)
+{
+    const FileRecord source_input = file_record(input_path);
+    const FileRecord source_stru = file_record(stru);
+    const FileRecord effective = file_record(archive / "INPUT.h0lite");
+    const FileRecord resolved = file_record(archive / "INPUT.resolved");
+    std::vector<std::string> requested_by;
+    if (vl_from_input)
+    {
+        requested_by.push_back("INPUT:out_mat_h_vl");
+    }
+    if (vl_from_cli)
+    {
+        requested_by.push_back("CLI:--with-vl");
+    }
+    std::ostringstream output;
+    output << "{\n"
+           << "  \"schema_version\": 1,\n"
+           << "  \"status\": \"complete\",\n"
+           << "  \"created_at_utc\": " << quote(utc_now()) << ",\n"
+           << "  \"generator\": " << quote(kGenerator) << ",\n"
+           << "  \"operator_contract\": " << quote(with_vl ? kH0VlContract : kH0Contract) << ",\n"
+           << "  \"output_validation\": {\"integrity_on_demand\": true, \"recorded_size_check\": false},\n"
+           << "  \"binary\": {\"source_commit\": " << quote(H0LITE_ABACUS_COMMIT) << "},\n"
+           << "  \"execution\": {\n"
+           << "    \"omp_num_threads\": " << cpus << ",\n"
+           << "    \"local_tasks\": " << tasks << ",\n"
+           << "    \"shard_index\": " << shard.index << ",\n"
+           << "    \"shard_count\": " << shard.count << ",\n"
+           << "    \"shard_source\": " << quote(shard.source) << ",\n"
+           << "    \"backend_contract\": " << quote(with_vl ? kBackendVlContract : kBackendContract) << ",\n"
+           << "    \"scf_iterations\": 0,\n"
+           << "    \"diagonalizations\": 0,\n"
+           << "    \"source_calculation\": " << quote(input_value(input, "calculation", "scf")) << ",\n"
+           << "    \"vl_included_in_h0\": " << (with_vl ? "true" : "false") << ",\n"
+           << "    \"separate_vl_output\": false\n"
+           << "  },\n"
+           << "  \"source_dft_functional\": " << quote(input_value(input, "dft_functional", "default")) << ",\n"
+           << "  \"nspin\": 1,\n"
+           << "  \"effective_operator_switches\": {\"t_in_h\": 1, \"vl_in_h\": "
+           << (with_vl ? 1 : 0) << ", \"vnl_in_h\": 1, \"dft_plus_u\": 0, \"deepks_scf\": 0},\n"
+           << "  \"inputs\": {\n"
+           << "    \"INPUT\": " << file_record_json(source_input, 4) << ",\n"
+           << "    \"STRU\": " << file_record_json(source_stru, 4) << "\n"
+           << "  },\n"
+           << "  \"dependencies\": [\n";
+    for (std::size_t i = 0; i < dependencies.size(); ++i)
+    {
+        const Dependency& item = dependencies[i];
+        output << "    {\"kind\": " << quote(item.kind) << ", \"name\": " << quote(item.name)
+               << ", \"declared_path\": " << quote(item.declared_path)
+               << ", \"resolved_path\": " << quote(item.file.path)
+               << ", \"size\": " << item.file.size << ", \"mtime_ns\": " << item.file.mtime_ns << "}";
+        output << (i + 1 == dependencies.size() ? "\n" : ",\n");
+    }
+    output << "  ],\n"
+           << "  \"effective_input\": {\n"
+           << "    \"path\": " << quote(effective.path) << ",\n"
+           << "    \"size\": " << effective.size << ",\n"
+           << "    \"mtime_ns\": " << effective.mtime_ns << ",\n"
+           << "    \"removed_unregistered_output_keys\": " << array_json(input.removed_keys) << "\n"
+           << "  },\n"
+           << "  \"resolved_input\": " << file_record_json(resolved, 2) << ",\n"
+           << "  \"optional_terms\": {\n"
+           << "    \"local_pseudopotential\": {\"enabled\": " << (with_vl ? "true" : "false")
+           << ", \"requested_by\": " << array_json(requested_by)
+           << ", \"relative_path\": null, \"density_dependent\": false, \"included_in_h0\": "
+           << (with_vl ? "true" : "false") << ", \"separate_output\": false}\n"
+           << "  },\n"
+           << "  \"case_directory\": " << quote(case_dir.string()) << ",\n"
+           << "  \"provenance_archive\": " << quote(archive.string()) << ",\n"
+           << "  \"outputs\": {\n"
+           << "    \"h0rs1_nao.csr\": {\"path\": " << quote(h0.path)
+           << ", \"relative_path\": \"h0rs1_nao.csr\", \"size\": " << h0.size << "},\n"
+           << "    \"s0r_nao.csr\": {\"path\": " << quote(s0.path)
+           << ", \"relative_path\": \"s0r_nao.csr\", \"size\": " << s0.size << "}\n"
+           << "  }\n"
+           << "}\n";
+    return output.str();
+}
+
+void set_threads(const int cpus)
+{
+    const std::string value = std::to_string(cpus);
+    setenv("OMP_NUM_THREADS", value.c_str(), 1);
+    setenv("OMP_DYNAMIC", "FALSE", 1);
+    setenv("MKL_NUM_THREADS", "1", 1);
+    setenv("MKL_DYNAMIC", "FALSE", 1);
+#ifdef _OPENMP
+    omp_set_dynamic(0);
+    omp_set_num_threads(cpus);
+#endif
+}
+
+int run_case(const fs::path& requested_case,
+             const bool cli_with_vl,
+             const int cpus,
+             const int tasks,
+             const Shard& shard)
+{
+    const fs::path case_dir = fs::absolute(requested_case).lexically_normal();
+    std::error_code error;
+    if (!fs::is_directory(case_dir, error) || error)
+    {
+        throw std::runtime_error("missing case directory: " + case_dir.string());
+    }
+    const fs::path input_path = case_dir / "INPUT";
+    const InputData input = parse_input(input_path);
+    validate_source_input(input);
+    const fs::path stru = resolve_from(case_dir, input_value(input, "stru_file", "STRU"));
+    file_record(stru);
+    const bool vl_from_input = parse_bool("out_mat_h_vl", input_value(input, "out_mat_h_vl", "0"));
+    const bool with_vl = cli_with_vl || vl_from_input;
+    const fs::path destination = case_dir / "OUT.ABACUS";
+    fs::create_directories(destination);
+    const fs::path marker = destination / kMarkerName;
+    if (reusable_marker(marker, with_vl))
+    {
+        std::cout << "H0LITE_REUSE " << case_dir << "\n";
+        return 0;
+    }
+    const std::vector<Dependency> dependencies = resolve_dependencies(case_dir, stru, input);
+    const fs::path final_h0 = destination / "h0rs1_nao.csr";
+    const fs::path final_s0 = destination / "s0r_nao.csr";
+    if (exists_or_symlink(final_h0) || exists_or_symlink(final_s0))
+    {
+        throw std::runtime_error("refusing unmarked pre-existing H0/S0 output in " + destination.string());
+    }
+
+    const std::string tag = unique_tag();
+    const fs::path stage = case_dir / (".get-H0-v311-h0lite-native-" + tag);
+    if (!fs::create_directory(stage))
+    {
+        throw std::runtime_error("cannot create stage: " + stage.string());
+    }
+    write_text_atomic(stage / "INPUT.h0lite", input.effective_text);
+    set_threads(cpus);
+    const fs::path old_directory = fs::current_path();
+    fs::current_path(case_dir);
+    try
+    {
+        h0lite_run_core((stage / "INPUT.h0lite").string(), stage.string(), with_vl);
+        fs::current_path(old_directory);
+    }
+    catch (...)
+    {
+        fs::current_path(old_directory);
+        throw;
+    }
+
+    validate_backend(stage / "running_h0lite.log", with_vl);
+    file_record(stage / "INPUT.resolved");
+    file_record(stage / "h0rs1_nao.csr");
+    file_record(stage / "s0r_nao.csr");
+
+    const fs::path archive_root = destination / "get_H0-v311-h0lite-provenance";
+    fs::create_directories(archive_root);
+    const fs::path archive = archive_root / tag;
+    fs::rename(stage, archive);
+    if (exists_or_symlink(final_h0) || exists_or_symlink(final_s0))
+    {
+        throw std::runtime_error("output appeared during H0Lite export in " + destination.string());
+    }
+    fs::rename(archive / "h0rs1_nao.csr", final_h0);
+    fs::rename(archive / "s0r_nao.csr", final_s0);
+    const FileRecord h0 = file_record(final_h0);
+    const FileRecord s0 = file_record(final_s0);
+    write_text_atomic(marker,
+                      marker_json(case_dir,
+                                  input_path,
+                                  stru,
+                                  input,
+                                  dependencies,
+                                  archive,
+                                  h0,
+                                  s0,
+                                  with_vl,
+                                  vl_from_input,
+                                  cli_with_vl,
+                                  cpus,
+                                  tasks,
+                                  shard));
+    std::cout << "H0LITE_COMPLETE " << case_dir << " h0_bytes=" << h0.size << " s0_bytes=" << s0.size
+              << " cpus=" << cpus << "\n";
+    return 0;
+}
+
+int environment_integer(const char* name, const int fallback)
+{
+    const char* raw = std::getenv(name);
+    if (raw == nullptr || *raw == '\0')
+    {
+        return fallback;
+    }
+    try
+    {
+        return parse_positive(name, raw);
+    }
+    catch (...)
+    {
+        return fallback;
+    }
+}
+
+int available_cpus()
+{
+    const int slurm = environment_integer("SLURM_CPUS_PER_TASK", 0);
+    if (slurm > 0)
+    {
+        return slurm;
+    }
+    cpu_set_t affinity;
+    CPU_ZERO(&affinity);
+    if (sched_getaffinity(0, sizeof(affinity), &affinity) == 0)
+    {
+        const int count = CPU_COUNT(&affinity);
+        if (count > 0)
+        {
+            return count;
+        }
+    }
+    const long online = sysconf(_SC_NPROCESSORS_ONLN);
+    return online > 0 && online <= INT_MAX ? static_cast<int>(online) : 1;
+}
+
+Shard resolve_shard(const Cli& cli)
+{
+    if ((cli.shard_index >= 0) != (cli.shard_count >= 0))
+    {
+        throw std::runtime_error("--shard-index and --shard-count must be given together");
+    }
+    if (cli.shard_count > 0)
+    {
+        if (cli.shard_index >= cli.shard_count)
+        {
+            throw std::runtime_error("--shard-index must be smaller than --shard-count");
+        }
+        return {cli.shard_index, cli.shard_count, "explicit"};
+    }
+    const int ntasks = environment_integer("SLURM_NTASKS", 1);
+    const char* proc_raw = std::getenv("SLURM_PROCID");
+    if (ntasks > 1 && proc_raw != nullptr)
+    {
+        const int proc = parse_nonnegative("SLURM_PROCID", proc_raw);
+        if (proc >= ntasks)
+        {
+            throw std::runtime_error("SLURM_PROCID is outside SLURM_NTASKS");
+        }
+        return {proc, ntasks, "SLURM_PROCID/SLURM_NTASKS"};
+    }
+    const char* array_raw = std::getenv("SLURM_ARRAY_TASK_ID");
+    const char* min_raw = std::getenv("SLURM_ARRAY_TASK_MIN");
+    const char* max_raw = std::getenv("SLURM_ARRAY_TASK_MAX");
+    if (array_raw != nullptr && min_raw != nullptr && max_raw != nullptr)
+    {
+        const int current = parse_nonnegative("SLURM_ARRAY_TASK_ID", array_raw);
+        const int minimum = parse_nonnegative("SLURM_ARRAY_TASK_MIN", min_raw);
+        const int maximum = parse_nonnegative("SLURM_ARRAY_TASK_MAX", max_raw);
+        const int step = environment_integer("SLURM_ARRAY_TASK_STEP", 1);
+        if (maximum < minimum || current < minimum || current > maximum || (current - minimum) % step != 0)
+        {
+            throw std::runtime_error("invalid Slurm array shard environment");
+        }
+        return {(current - minimum) / step, (maximum - minimum) / step + 1, "SLURM_ARRAY_TASK_ID"};
+    }
+    return {};
+}
+
+std::vector<fs::path> collect_cases(const Cli& cli)
+{
+    std::vector<fs::path> cases;
+    for (const std::string& item : cli.positional_cases)
+    {
+        cases.push_back(item);
+    }
+    if (!cli.case_list.empty())
+    {
+        const fs::path list = fs::absolute(cli.case_list).lexically_normal();
+        const fs::path base = list.parent_path();
+        std::ifstream input(list);
+        if (!input)
+        {
+            throw std::runtime_error("cannot read case list: " + list.string());
+        }
+        std::string line;
+        while (std::getline(input, line))
+        {
+            const std::string clean = uncomment(line);
+            if (clean.empty())
+            {
+                continue;
+            }
+            fs::path path(clean);
+            if (path.is_relative())
+            {
+                path = base / path;
+            }
+            cases.push_back(fs::absolute(path).lexically_normal());
+        }
+    }
+    if (cases.empty())
+    {
+        cases.push_back(fs::current_path());
+    }
+    std::set<std::string> seen;
+    std::vector<fs::path> unique;
+    for (const fs::path& requested : cases)
+    {
+        const fs::path path = fs::absolute(requested).lexically_normal();
+        if (!seen.insert(path.string()).second)
+        {
+            throw std::runtime_error("duplicate case directory: " + path.string());
+        }
+        unique.push_back(path);
+    }
+    return unique;
+}
+
+int run_batch(const std::vector<fs::path>& all_cases,
+              const Cli& cli,
+              const int cpus,
+              const Shard& shard)
+{
+    std::vector<fs::path> cases;
+    for (std::size_t index = 0; index < all_cases.size(); ++index)
+    {
+        if (static_cast<int>(index % static_cast<std::size_t>(shard.count)) == shard.index)
+        {
+            cases.push_back(all_cases[index]);
+        }
+    }
+    if (cases.empty())
+    {
+        std::cout << "H0LITE_SHARD_EMPTY index=" << shard.index << " count=" << shard.count << "\n";
+        return 0;
+    }
+    const int parallel = std::min(cli.tasks, static_cast<int>(cases.size()));
+    std::map<pid_t, fs::path> running;
+    std::size_t next = 0;
+    int failures = 0;
+    while (next < cases.size() || !running.empty())
+    {
+        while (next < cases.size() && static_cast<int>(running.size()) < parallel)
+        {
+            std::cout.flush();
+            std::cerr.flush();
+            const fs::path current = cases[next++];
+            const pid_t child = fork();
+            if (child < 0)
+            {
+                throw std::runtime_error("fork failed: " + std::string(std::strerror(errno)));
+            }
+            if (child == 0)
+            {
+                try
+                {
+                    const int status = run_case(current, cli.with_vl, cpus, parallel, shard);
+                    std::cout.flush();
+                    std::cerr.flush();
+                    _exit(status);
+                }
+                catch (const std::exception& error)
+                {
+                    std::cerr << "H0LITE_CASE_ERROR " << current << ": " << error.what() << "\n";
+                    std::cerr.flush();
+                    _exit(2);
+                }
+            }
+            running[child] = current;
+        }
+        int status = 0;
+        const pid_t child = waitpid(-1, &status, 0);
+        if (child < 0)
+        {
+            if (errno == EINTR)
+            {
+                continue;
+            }
+            throw std::runtime_error("waitpid failed: " + std::string(std::strerror(errno)));
+        }
+        const auto found = running.find(child);
+        const fs::path current = found == running.end() ? fs::path("unknown") : found->second;
+        if (!WIFEXITED(status) || WEXITSTATUS(status) != 0)
+        {
+            ++failures;
+            std::cerr << "H0LITE_FAILED " << current << " status=" << status << "\n";
+        }
+        running.erase(child);
+    }
+    std::cout << "H0LITE_SUMMARY selected=" << cases.size() << " complete=" << (cases.size() - failures)
+              << " failed=" << failures << " shard=" << shard.index << "/" << shard.count << "\n";
+    return failures == 0 ? 0 : 2;
+}
+
+void print_license()
+{
+    std::cout << "===== ABACUS / LGPL-3.0 =====\n"
+              << kAbacusLicenseText
+              << "\n===== GCC Runtime Library Exception 3.1 =====\n"
+              << kGccRuntimeLicenseText
+              << "\n===== Intel oneMKL license =====\n"
+              << kMklLicenseText
+              << "\n===== Intel oneMKL third-party notices =====\n"
+              << kMklThirdPartyText << "\n";
+}
+
+} // namespace
+
+int main(int argc, char** argv)
+{
+    try
+    {
+        const Cli cli = parse_cli(argc, argv);
+        if (cli.show_help)
+        {
+            usage(std::cout);
+            return 0;
+        }
+        if (cli.show_version)
+        {
+            std::cout << "abacus_h0 ABACUS-source " << H0LITE_ABACUS_COMMIT << "\n";
+            return 0;
+        }
+        if (cli.show_license)
+        {
+            print_license();
+            return 0;
+        }
+        const bool raw_mode = !cli.raw_input.empty() || !cli.raw_output_dir.empty();
+        if (raw_mode)
+        {
+            if (cli.raw_input.empty() || cli.raw_output_dir.empty() || !cli.case_list.empty()
+                || !cli.positional_cases.empty() || cli.tasks != 1 || cli.shard_index >= 0)
+            {
+                throw std::runtime_error("--input and --output-dir form a private compatibility pair");
+            }
+            const int cpus = cli.cpus_per_task > 0 ? cli.cpus_per_task : available_cpus();
+            set_threads(cpus);
+            return h0lite_run_core(cli.raw_input, cli.raw_output_dir, cli.with_vl);
+        }
+
+        const std::vector<fs::path> all_cases = collect_cases(cli);
+        const Shard shard = resolve_shard(cli);
+        const int available = available_cpus();
+        const int cpus = cli.cpus_per_task > 0 ? cli.cpus_per_task : std::max(1, available / cli.tasks);
+        if (cli.tasks > available || static_cast<long long>(cli.tasks) * cpus > available)
+        {
+            throw std::runtime_error("--tasks * --cpus-per-task exceeds CPUs allocated to this process ("
+                                     + std::to_string(available) + ")");
+        }
+        const bool single = all_cases.size() == 1 && shard.count == 1 && cli.tasks == 1;
+        if (single)
+        {
+            return run_case(all_cases.front(), cli.with_vl, cpus, 1, shard);
+        }
+        return run_batch(all_cases, cli, cpus, shard);
+    }
+    catch (const std::exception& error)
+    {
+        std::cerr << "H0LITE_ERROR: " << error.what() << "\n";
+        return 2;
+    }
+}
