+                     PARAM.inp.nspin,
+                     PARAM.inp.basis_type,
+                     PARAM.inp.orbital_dir,
+                     PARAM.inp.init_wfc,
+                     PARAM.inp.onsite_radius,
+                     false,
+                     false,
+                     PARAM.inp.fixed_atoms,
+                     PARAM.inp.noncolin,
+                     PARAM.inp.calculation,
+                     PARAM.inp.esolver_type,
+                     std::stoi(PARAM.inp.symmetry));
+    unitcell::check_atomic_stru(ucell, PARAM.inp.min_dist_coef);
+
+    read_pseudopotentials(ucell, GlobalV::ofs_running);
+    CalAtomsInfo atom_info_calculator;
+    const AtomsInfoResult atoms_info = atom_info_calculator.cal_atoms_info(ucell.atoms,
+                                                                            ucell.ntype,
+                                                                            PARAM.inp.nspin,
+                                                                            PARAM.globalv.two_fermi,
+                                                                            PARAM.inp.nelec_delta,
+                                                                            PARAM.inp.esolver_type,
+                                                                            PARAM.inp.lspinorb,
+                                                                            PARAM.inp.basis_type,
+                                                                            PARAM.inp.smearing_method,
+                                                                            PARAM.inp.ks_solver,
+                                                                            PARAM.inp.bndpar,
+                                                                            PARAM.inp.nbands,
+                                                                            PARAM.inp.nelec,
+                                                                            PARAM.inp.nupdown);
+    elecstate::ParamUpdater::update_from_atoms_info(atoms_info);
