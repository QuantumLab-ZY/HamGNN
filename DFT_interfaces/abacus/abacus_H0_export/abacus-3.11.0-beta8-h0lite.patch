+
+#ifndef H0LITE_ABACUS_COMMIT
+#define H0LITE_ABACUS_COMMIT "unknown"
+#endif
+
+namespace
+{
+
+constexpr const char* kContract
+    = "H0LITE_V353_CONTRACT: H0=T+Vnl; S0=NAO overlap; SCF iterations=0; diagonalizations=0";
+constexpr const char* kVlContract
+    = "H0LITE_VL_MERGED_CONTRACT: H0=T+Vnl+Vl; Vl=<NAO|Vlocal_pseudopotential|NAO>; density inputs=0; separate Vl output=0; SCF iterations=0; diagonalizations=0";
+
+struct Config
+{
+    std::string input;
+    std::string output_dir;
+    bool with_vl = false;
+};
+
+std::string directory(std::string value)
+{
+    if (value.empty())
+    {
+        throw std::runtime_error("directory argument must not be empty");
+    }
+    if (value.back() != '/')
+    {
+        value.push_back('/');
+    }
+    return value;
+}
+
+void require_directory(const std::string& value)
+{
+    struct stat info
+    {
+    };
+    if (stat(value.c_str(), &info) != 0 || !S_ISDIR(info.st_mode))
+    {
+        throw std::runtime_error("directory does not exist: " + value);
+    }
+}
+
+bool path_exists(const std::string& value)
+{
+    struct stat info
+    {
+    };
+    return stat(value.c_str(), &info) == 0;
+}
+
+std::string element_key(const std::string& value)
+{
+    std::string key;
+    for (const char ch : value)
+    {
+        if (!std::isalpha(static_cast<unsigned char>(ch)))
+        {
+            break;
+        }
+        key.push_back(static_cast<char>(std::tolower(static_cast<unsigned char>(ch))));
+    }
+    return key;
+}
+
+void read_pseudopotentials(UnitCell& ucell, std::ofstream& log)
+{
+    for (int it = 0; it < ucell.ntype; ++it)
+    {
+        Atom& atom = ucell.atoms[it];
+        Pseudopot_upf reader;
+        reader.coulomb_potential = atom.coulomb_potential;
+        const std::string path = PARAM.inp.pseudo_dir + ucell.pseudo_fn[it];
+        const int error = reader.init_pseudo_reader(path, ucell.pseudo_type[it], atom.ncpp);
+        if (error != 0)
+        {
+            throw std::runtime_error("failed to read pseudopotential (error " + std::to_string(error) + "): " + path);
+        }
+        if (atom.flag_empty_element)
+        {
+            reader.set_empty_element(atom.ncpp);
+        }
+        reader.set_upf_q(atom.ncpp);
+        if (reader.average_p(PARAM.inp.soc_lambda, atom.ncpp, PARAM.inp.lspinorb) != 0)
+        {
+            throw std::runtime_error("failed to scalar-average pseudopotential: " + path);
+        }
+        reader.complete_default(atom.ncpp, PARAM.inp.pseudo_rcut);
+        atom.coulomb_potential = reader.coulomb_potential;
+        if (atom.ncpp.pp_type != "NC")
+        {
+            throw std::runtime_error("h0lite LCAO route requires an NC pseudopotential: " + path);
+        }
+        if (!atom.label_orb.empty() && element_key(atom.label_orb) != element_key(atom.ncpp.psd))
+        {
+            throw std::runtime_error("orbital/pseudopotential element mismatch for " + atom.label);
+        }
+        log << "Pseudopotential " << atom.label << ": " << path << " (" << atom.ncpp.nbeta
+            << " projectors)\n";
+    }
+}
+
+void write_matrix(const std::string& final_path,
+                  const std::string& label,
+                  const UnitCell& ucell,
+                  hamilt::HContainer<double>& matrix,
+                  const int precision)
+{
+    const std::string temporary = final_path + ".tmp." + std::to_string(static_cast<long long>(getpid()));
+    std::ofstream output(temporary);
+    if (!output)
+    {
+        throw std::runtime_error("cannot open output: " + temporary);
+    }
+    output << " --- Ionic Step 1 ---\n";
+    output << " # print " << label << " matrix in real space " << label << "(R)\n";
+    output << " 1 # number of spin directions\n";
+    output << " 1 # spin index\n";
+    output << " " << matrix.get_nbasis() << " # number of localized basis\n";
+    output << " " << matrix.size_R_loop() << " # number of Bravais lattice vector R\n\n";
+    ModuleIO::UcellIO::write_ucell(output, &ucell);
+    output << "\n";
+    constexpr double sparse_threshold = 1.0e-10;
+    hamilt::Output_HContainer<double> writer(&matrix, output, sparse_threshold, precision);
+    writer.write();
+    output.close();
+    if (!output)
+    {
+        std::remove(temporary.c_str());
+        throw std::runtime_error("failed while writing output: " + temporary);
+    }
+    if (std::rename(temporary.c_str(), final_path.c_str()) != 0)
+    {
+        const int error = errno;
+        std::remove(temporary.c_str());
+        throw std::runtime_error("cannot install output " + final_path + ": errno " + std::to_string(error));
+    }
+}
+
+long long milliseconds(const std::chrono::steady_clock::time_point& start)
+{
+    return std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - start).count();
+}
+
+int run(const Config& config)
+{
+    const auto total_start = std::chrono::steady_clock::now();
+    const std::string log_path = config.output_dir + "running_h0lite.log";
+    const std::string warning_path = config.output_dir + "warning_h0lite.log";
+    const std::string resolved_input_path = config.output_dir + "INPUT.resolved";
+    const std::vector<std::string> protected_outputs = {
+        config.output_dir + "h0rs1_nao.csr",
+        config.output_dir + "s0r_nao.csr",
+        resolved_input_path,
+        log_path,
+        warning_path};
+    for (const std::string& path : protected_outputs)
+    {
+        if (path_exists(path))
+        {
+            throw std::runtime_error("refusing to overwrite existing output: " + path);
+        }
+    }
+    GlobalV::ofs_running.open(log_path);
+    GlobalV::ofs_warning.open(warning_path);
+    if (!GlobalV::ofs_running || !GlobalV::ofs_warning)
+    {
+        throw std::runtime_error("cannot open h0lite logs in " + config.output_dir);
+    }
+
+    GlobalV::MY_RANK = 0;
+    GlobalV::NPROC = 1;
+    PARAM.set_pal_param(0, 1, 1);
+    ModuleIO::ReadInput input_reader(0);
+    input_reader.skip_parameter_checks = true;
+    input_reader.read_parameters(PARAM, config.input);
+    const bool input_requests_vl
+        = !PARAM.inp.out_mat_h_vl.empty() && PARAM.inp.out_mat_h_vl.front() != 0;
+    const bool include_vl = config.with_vl || input_requests_vl;
+    const char* active_contract = include_vl ? kVlContract : kContract;
+
+    if (PARAM.inp.basis_type != "lcao")
+    {
+        throw std::runtime_error("H0Lite requires basis_type=lcao in the SCF INPUT");
+    }
+    if (PARAM.inp.gamma_only)
+    {
+        throw std::runtime_error("H0Lite graph export requires gamma_only=0 in the SCF INPUT");
+    }
+    if (PARAM.inp.nspin != 1 || PARAM.inp.noncolin || PARAM.inp.lspinorb)
+    {
+        throw std::runtime_error("H0Lite currently requires scalar nspin=1 without SOC/noncollinear spin");
+    }
+    if (PARAM.inp.esolver_type != "ksdft")
+    {
+        throw std::runtime_error("H0Lite currently requires esolver_type=ksdft");
+    }
+    if (!PARAM.inp.t_in_h || !PARAM.inp.vnl_in_h)
+    {
+        throw std::runtime_error("the SCF INPUT must enable t_in_h=1 and vnl_in_h=1 for the strict H0 contract");
+    }
+    if (PARAM.inp.ntype <= 0 || PARAM.inp.lcao_ecut <= 0.0 || PARAM.inp.lcao_dk <= 0.0
+        || PARAM.inp.lcao_dr <= 0.0 || PARAM.inp.lcao_rmax <= 0.0 || PARAM.inp.pseudo_rcut <= 0.0
+        || PARAM.inp.out_hsr.size() < 2 || PARAM.inp.out_hsr[1] <= 0)
+    {
+        throw std::runtime_error("invalid SCF INPUT parameter required by H0Lite");
+    }
+    input_reader.write_parameters(PARAM, resolved_input_path);
+
+    GlobalV::ofs_running << "ABACUS H0Lite\n"
+                         << "ABACUS source commit: " << H0LITE_ABACUS_COMMIT << "\n"
+                         << "SCF INPUT: " << config.input << "\n"
+                         << "calculation_from_input: " << PARAM.inp.calculation << "\n"
+                         << "STRU: " << PARAM.globalv.global_in_stru << "\n"
+                         << "pseudo_dir: " << PARAM.inp.pseudo_dir << "\n"
+                         << "orbital_dir: " << PARAM.inp.orbital_dir << "\n"
+                         << std::setprecision(17)
+                         << "lcao_ecut: " << PARAM.inp.lcao_ecut << "\n"
+                         << "lcao_dk: " << PARAM.inp.lcao_dk << "\n"
+                         << "lcao_dr: " << PARAM.inp.lcao_dr << "\n"
+                         << "lcao_rmax: " << PARAM.inp.lcao_rmax << "\n"
+                         << "pseudo_rcut: " << PARAM.inp.pseudo_rcut << "\n"
+                         << "csr_precision_from_input: " << PARAM.inp.out_hsr.at(1) << "\n"
+                         << "vl_included_in_h0: " << include_vl << "\n"
+                         << "vl_requested_by_input: " << input_requests_vl << "\n"
+                         << "h0_operator: " << (include_vl ? "T+Vnl+Vl" : "T+Vnl") << "\n"
+                         << "excluded_density_or_state_dependent_terms: Hartree, XC, DFT+U, EXX, DeePKS, spin constraint\n";
+
+    UnitCell ucell;
+    ucell.setup_from_input(PARAM.inp.latname,
+                           PARAM.inp.ntype,
+                           PARAM.inp.lmaxmax,
+                           PARAM.inp.init_vel,
+                           PARAM.inp.fixed_axes);
+    ucell.setup_cell(PARAM.globalv.global_in_stru,
+                     GlobalV::ofs_running,
+                     PARAM.inp.symmetry_prec,
+                     PARAM.inp.dfthalf_type,
+                     PARAM.inp.pseudo_dir,
+                     PARAM.inp.nspin,
+                     PARAM.inp.basis_type,
+                     PARAM.inp.orbital_dir,
+                     PARAM.inp.init_wfc,
+                     PARAM.inp.onsite_radius,
+                     false,
+                     false,
+                     PARAM.inp.fixed_atoms,
+                     PARAM.inp.noncolin,
+                     PARAM.inp.calculation,
+                     PARAM.inp.esolver_type,
+                     std::stoi(PARAM.inp.symmetry));
+    unitcell::check_atomic_stru(ucell, PARAM.inp.min_dist_coef);
+
+    read_pseudopotentials(ucell, GlobalV::ofs_running);
+    CalAtomsInfo atom_info_calculator;
+    const AtomsInfoResult atoms_info = atom_info_calculator.cal_atoms_info(ucell.atoms,
+                                                                            ucell.ntype,
+                                                                            PARAM.inp.nspin,
+                                                                            PARAM.globalv.two_fermi,
+                                                                            PARAM.inp.nelec_delta,
+                                                                            PARAM.inp.esolver_type,
+                                                                            PARAM.inp.lspinorb,
+                                                                            PARAM.inp.basis_type,
+                                                                            PARAM.inp.smearing_method,
+                                                                            PARAM.inp.ks_solver,
+                                                                            PARAM.inp.bndpar,
+                                                                            PARAM.inp.nbands,
+                                                                            PARAM.inp.nelec,
+                                                                            PARAM.inp.nupdown);
+    elecstate::ParamUpdater::update_from_atoms_info(atoms_info);
+    const int nlocal = atoms_info.nlocal;
+    unitcell::cal_nwfc(GlobalV::ofs_running,
+                       ucell,
+                       ucell.atoms,
+                       PARAM.inp.nspin,
+                       nlocal,
+                       PARAM.globalv.npol,
+                       PARAM.inp.basis_type,
+                       PARAM.inp.esolver_type,
+                       PARAM.inp.init_wfc,
+                       PARAM.inp.nbands);
+
+    TwoCenterBundle two_center;
+    LCAO_Orbitals orbitals;
+    two_center.build_orb(ucell.ntype, ucell.orbital_fn.data(), PARAM.inp.orbital_dir);
+    two_center.to_LCAO_Orbitals(orbitals,
+                                PARAM.inp.lcao_ecut,
+                                PARAM.inp.lcao_dk,
+                                PARAM.inp.lcao_dr,
+                                PARAM.inp.lcao_rmax,
+                                PARAM.inp.out_element_info,
+                                PARAM.inp.cal_force);
+    auto* nonlocal_info = new LCAONonlocalInfo();
+    nonlocal_info->setupNonlocal(ucell.ntype,
+                                 ucell.atoms,
+                                 GlobalV::ofs_running,
+                                 orbitals,
+                                 PARAM.inp.basis_type,
+                                 PARAM.inp.out_element_info,
+                                 PARAM.inp.lspinorb,
+                                 PARAM.inp.nspin);
+    ucell.infoNL.reset(nonlocal_info);
+    two_center.build_beta(ucell.ntype, nonlocal_info->get_nonlocal().Beta);
+    two_center.tabulate();
+    const long long setup_ms = milliseconds(total_start);
+
+    Parallel_Orbitals pv;
+    pv.set_serial(nlocal, nlocal);
+    pv.nrow_bands = nlocal;
+    pv.ncol_bands = PARAM.inp.nbands;
+    pv.set_atomic_trace(ucell.get_iat2iwt(), ucell.nat, nlocal);
+
+    const double search_radius = atom_arrange::set_sr_NL(GlobalV::ofs_running,
+                                                          PARAM.inp.out_level,
+                                                          orbitals.get_rcutmax_Phi(),
+                                                          ucell.infoNL->get_rcutmax_Beta(),
+                                                          PARAM.globalv.gamma_only_local);
+    Grid_Driver grid;
+    atom_arrange::search(PARAM.globalv.search_pbc,
+                         GlobalV::ofs_running,
+                         grid,
+                         ucell,
+                         search_radius,
+                         PARAM.inp.test_atom_input);
+
+    const std::vector<ModuleBase::Vector3<double>> unused_kvec(
+        1, ModuleBase::Vector3<double>(0.0, 0.0, 0.0));
+    hamilt::HContainer<double> s0(&pv);
+    hamilt::HContainer<double> kinetic_matrix(&pv);
+    hamilt::HContainer<double> nonlocal_matrix(&pv);
+
+    const auto matrix_start = std::chrono::steady_clock::now();
+    hamilt::Overlap<hamilt::OperatorLCAO<std::complex<double>, double>> overlap(
+        nullptr,
+        unused_kvec,
+        nullptr,
+        &s0,
+        &ucell,
+        orbitals.cutoffs(),
+        &grid,
+        two_center.overlap_orb.get());
+    overlap.contributeHR();
+
+    hamilt::EKinetic<hamilt::OperatorLCAO<std::complex<double>, double>> kinetic(
+        nullptr,
+        unused_kvec,
+        &kinetic_matrix,
+        &ucell,
+        orbitals.cutoffs(),
+        &grid,
+        two_center.kinetic_orb.get());
+    kinetic.contributeHR();
+
+    hamilt::Nonlocal<hamilt::OperatorLCAO<std::complex<double>, double>> nonlocal(
+        nullptr,
+        unused_kvec,
+        &nonlocal_matrix,
+        &ucell,
+        orbitals.cutoffs(),
+        &grid,
+        two_center.overlap_orb_beta.get());
+    nonlocal.contributeHR();
+    kinetic_matrix.add_value_union(nonlocal_matrix, 1.0);
+    const long long matrix_ms = milliseconds(matrix_start);
+
+    long long vl_ms = 0;
+    if (include_vl)
+    {
+        const auto vl_start = std::chrono::steady_clock::now();
+        if (PARAM.globalv.double_grid)
+        {
+            throw std::runtime_error("H0Lite local-pseudopotential term currently requires the single LCAO density grid");
+        }
+
+        std::string fft_precision = "double";
+        if (PARAM.inp.precision == "single" || PARAM.inp.precision == "mixing")
+        {
+            fft_precision = "mixing";
+        }
+        std::unique_ptr<ModulePW::PW_Basis_Big> pw_rho(
+            new ModulePW::PW_Basis_Big("cpu", fft_precision));
+        pw_rho->setbxyz(PARAM.inp.bx, PARAM.inp.by, PARAM.inp.bz);
+        if (PARAM.inp.nx * PARAM.inp.ny * PARAM.inp.nz == 0)
+        {
+            pw_rho->initgrids(PARAM.inp.ref_cell_factor * ucell.lat0,
+                              ucell.latvec,
+                              4.0 * PARAM.inp.ecutwfc);
+        }
+        else
+        {
+            pw_rho->initgrids(PARAM.inp.ref_cell_factor * ucell.lat0,
+                              ucell.latvec,
+                              PARAM.inp.nx,
+                              PARAM.inp.ny,
+                              PARAM.inp.nz);
+        }
+        pw_rho->initparameters(false, 4.0 * PARAM.inp.ecutwfc);
+        pw_rho->fft_bundle.initfftmode(PARAM.inp.fft_mode);
+        static_cast<ModulePW::PW_Basis*>(pw_rho.get())->setuptransform();
+        pw_rho->collect_local_pw();
+        pw_rho->collect_uniqgg();
+
+        Parallel_Grid parallel_grid;
+        parallel_grid.init(pw_rho->nx,
+                           pw_rho->ny,
+                           pw_rho->nz,
+                           pw_rho->nplane,
+                           pw_rho->nrxx,
+                           pw_rho->nbz,
+                           pw_rho->bz);
+        Structure_Factor structure_factor;
+        structure_factor.set(pw_rho.get(), PARAM.inp.nbspline);
+        structure_factor.setup(&ucell, parallel_grid, pw_rho.get());
+
+        pseudopot_cell_vl local_pseudopotential;
+        local_pseudopotential.init_vloc(ucell, pw_rho.get());
+        std::vector<double> local_potential_grid(pw_rho->nrxx, 0.0);
+        double vl_of_zero = 0.0;
+        elecstate::PotLocal pot_local(&local_pseudopotential.vloc,
+                                      &structure_factor.strucFac,
+                                      pw_rho.get(),
+                                      vl_of_zero);
+        pot_local.cal_fixed_v(local_potential_grid.data());
+
+        std::unique_ptr<ModuleGint::GintInfo> gint_info(new ModuleGint::GintInfo(
+            pw_rho->nbx,
+            pw_rho->nby,
+            pw_rho->nbz,
+            pw_rho->nx,
+            pw_rho->ny,
+            pw_rho->nz,
+            0,
+            0,
+            pw_rho->nbzp_start,
+            pw_rho->nbx,
+            pw_rho->nby,
+            pw_rho->nbzp,
+            orbitals.Phi,
+            ucell,
+            grid));
+        ModuleGint::Gint::set_gint_info(gint_info.get());
+        hamilt::HContainer<double> vl_matrix(&pv, nullptr, &gint_info->get_ijr_info());
+        ModuleGint::Gint_vl vl_integrator(local_potential_grid.data(), &vl_matrix);
+        vl_integrator.cal_gint();
+        ModuleGint::Gint::set_gint_info(nullptr);
+        kinetic_matrix.add_value_union(vl_matrix, 1.0);
+        vl_ms = milliseconds(vl_start);
+        GlobalV::ofs_running << "vl_fft_grid: " << pw_rho->nx << " " << pw_rho->ny << " " << pw_rho->nz << "\n"
+                             << "vl_of_g0: " << std::setprecision(17) << vl_of_zero << "\n"
+                             << "vl_r_blocks_merged: " << vl_matrix.size_R_loop() << "\n";
+    }
+
+    write_matrix(config.output_dir + "h0rs1_nao.csr", "H", ucell, kinetic_matrix, PARAM.inp.out_hsr.at(1));
+    write_matrix(config.output_dir + "s0r_nao.csr", "S", ucell, s0, PARAM.inp.out_hsr.at(1));
+    const long long total_ms = milliseconds(total_start);
+
+    GlobalV::ofs_running << active_contract << "\n"
+                         << "basis_dimension: " << nlocal << "\n"
+                         << "h0_r_blocks: " << kinetic_matrix.size_R_loop() << "\n"
+                         << "s0_r_blocks: " << s0.size_R_loop() << "\n"
+                         << "setup_ms: " << setup_ms << "\n"
+                         << "matrix_ms: " << matrix_ms << "\n"
+                         << "vl_ms: " << vl_ms << "\n"
+                         << "total_ms: " << total_ms << "\n"
+                         << "Finish Time\n";
+    GlobalV::ofs_running.close();
+    GlobalV::ofs_warning.close();
+
+    std::cout << active_contract << "\n"
+              << "basis_dimension=" << nlocal << " setup_ms=" << setup_ms << " matrix_ms=" << matrix_ms
+              << " total_ms=" << total_ms << std::endl;
+    return 0;
+}
+
+} // namespace
+
+int h0lite_run_core(const std::string& input, const std::string& output_dir, const bool with_vl)
+{
+    Config config;
+    config.input = input;
+    config.output_dir = directory(output_dir);
+    config.with_vl = with_vl;
+    require_directory(config.output_dir);
+    if (!path_exists(config.input))
+    {
+        throw std::runtime_error("INPUT does not exist: " + config.input);
+    }
+    return run(config);
+}
