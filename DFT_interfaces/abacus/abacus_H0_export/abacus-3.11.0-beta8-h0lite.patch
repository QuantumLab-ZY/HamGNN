+void TwoCenterBundle::tabulate_h0_compat(double lcao_ecut, double lcao_dk,
+                                        double lcao_dr, double lcao_rmax)
+{
+    ModuleBase::SphericalBesselTransformer sbt(true);
+    orb_->set_transformer(sbt);
+    beta_->set_transformer(sbt);
+    int nk = static_cast<int>((lcao_ecut < 20 ? 2.0 : 1.0) * std::sqrt(lcao_ecut) / lcao_dk) + 4;
+    nk += 1 - nk % 2;
+    std::vector<double> kgrid(nk);
+    for (int ik = 0; ik < nk; ++ik) kgrid[ik] = ik * lcao_dk;
+    orb_->set_grid(false, nk, kgrid.data(), 't');
+    beta_->set_grid(false, nk, kgrid.data(), 't');
+
+    using Interpolation = TwoCenterTable::Interpolation;
+    const auto build = [&](std::unique_ptr<TwoCenterIntegrator>& integrator,
+                           const RadialCollection& ket, char op, Interpolation interpolation) {
+        const double cutoff = orb_->rcut_max() + ket.rcut_max();
+        int nr = static_cast<int>(cutoff / lcao_dr) + 5;
+        nr += 1 - nr % 2;
+        int capacity = static_cast<int>(lcao_rmax / lcao_dr) + 4;
+        capacity += 1 - capacity % 2;
+        if (nr >= capacity)
+            throw std::runtime_error("lcao_rmax must exceed the largest H0 orbital/projector pair cutoff");
+        integrator.reset(new TwoCenterIntegrator(interpolation));
+        integrator->tabulate(*orb_, ket, op, nr, (nr - 1) * lcao_dr);
+    };
+    build(kinetic_orb, *orb_, 'T', Interpolation::FourPointOrbital);
+    build(overlap_orb, *orb_, 'S', Interpolation::FourPointOrbital);
+    build(overlap_orb_beta, *beta_, 'S', Interpolation::FourPointProjector);
+    ModuleBase::Memory::record("TwoCenterTable: Kinetic", kinetic_orb->table_memory());
+    ModuleBase::Memory::record("TwoCenterTable: Overlap", overlap_orb->table_memory());
+    ModuleBase::Memory::record("TwoCenterTable: Nonlocal", overlap_orb_beta->table_memory());
+    sbt.clear();
+}
